#! @bashlocation@

set -e

cd $(dirname "$0")

. @bashlibloc@/mge-basic-lib.sh

set +e

mge_basic_lib_output "Test-00-15 should produce no output" 15 0 15 1> test-00-15-stdout-result.txt 2> test-00-15-stderr-result.txt

# Should fail and exit 79 because where is 0
if (( $? != 79 )); then
	exit 1
fi

set -e

cmp test-00-15-stdout-answer.txt test-00-15-stdout-result.txt

cmp test-00-15-stderr-answer.txt test-00-15-stderr-result.txt

cd -

