#! @bashlocation@

set -e

cd $(dirname "$0")

. @bashlibloc@/mge-basic-lib.sh

set +e

mge_basic_lib_output "Test-02-07 Should produce no output" 7 2 7 1> test-02-07-stdout-result.txt 2> test-02-07-stderr-result.txt

# Should fail and exit 79 because when is 7
if (( $? != 79 )); then
	exit 1
fi

set -e

cmp test-02-07-stdout-answer.txt test-02-07-stdout-result.txt

cmp test-02-07-stderr-answer.txt test-02-07-stderr-result.txt

cd -

