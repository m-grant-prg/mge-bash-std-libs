#! @bashlocation@

set -e

cd $(dirname "$0")

. @bashlibloc@/mge-basic-lib.sh

set +e

mge_basic_lib_output "Test-03-12 Should produce no output" 12 3 12 1> test-03-12-stdout-result.txt 2> test-03-12-stderr-result.txt

# Should fail and exit 79 because where is 3
if (( $? != 79 )); then
	exit 1
fi

set -e

cmp test-03-12-stdout-answer.txt test-03-12-stdout-result.txt

cmp test-03-12-stderr-answer.txt test-03-12-stderr-result.txt

cd -

