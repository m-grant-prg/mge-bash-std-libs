#! @bashlocation@

set -e

cd $(dirname "$0")

. @bashlibloc@/mge-basic-lib.sh

set +e

mge_basic_lib_output "Test-02-05 Should produce no output" 5 2 5 1> test-02-05-stdout-result.txt 2> test-02-05-stderr-result.txt

# Should fail and exit 79 because when is 5
if (( $? != 79 )); then
	exit 1
fi

set -e

cmp test-02-05-stdout-answer.txt test-02-05-stdout-result.txt

cmp test-02-05-stderr-answer.txt test-02-05-stderr-result.txt

cd -

