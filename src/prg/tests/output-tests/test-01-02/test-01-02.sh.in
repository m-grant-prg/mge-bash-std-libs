#! @bashlocation@

set -e

cd "$(dirname "$0")"

. @bashlibloc@/mge-basic-lib.sh

VERBOSITY=$(( mge_basic_lib_when_standard | mge_basic_lib_when_quiet ))

mge_basic_lib_output "Test-01-02 Answer should be stdout only" "$VERBOSITY" 1> test-01-02-stdout-result.txt 2> test-01-02-stderr-result.txt

set -e

cmp test-01-02-stdout-answer.txt test-01-02-stdout-result.txt

cmp test-01-02-stderr-answer.txt test-01-02-stderr-result.txt

cd -

