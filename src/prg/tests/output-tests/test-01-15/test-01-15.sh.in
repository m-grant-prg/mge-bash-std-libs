#! @bashlocation@

set -e

cd $(dirname "$0")

. @bashlibloc@/mge-basic-lib.sh

set +e

mge_basic_lib_output "Test-01-15 Should produce no output" 15 1 15 1> test-01-15-stdout-result.txt 2> test-01-15-stderr-result.txt

# Should fail and exit 79 because when is 15
if (( $? != 79 )); then
	exit 1
fi

set -e

cmp test-01-15-stdout-answer.txt test-01-15-stdout-result.txt

cmp test-01-15-stderr-answer.txt test-01-15-stderr-result.txt

cd -

