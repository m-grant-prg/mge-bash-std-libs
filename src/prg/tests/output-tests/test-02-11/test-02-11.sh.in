#! @bashlocation@

set -e

cd $(dirname "$0")

. @bashlibloc@/mge-basic-lib.sh

set +e

mge_basic_lib_output "Test-02-11 Should produce no output" 11 2 11 1> test-02-11-stdout-result.txt 2> test-02-11-stderr-result.txt

# Should fail and exit 79 because when is 11
if (( $? != 79 )); then
	exit 1
fi

set -e

cmp test-02-11-stdout-answer.txt test-02-11-stdout-result.txt

cmp test-02-11-stderr-answer.txt test-02-11-stderr-result.txt

cd -

